<configuration>
    <conversionRule conversionWord="aphighlight"
                    converterClass="org.dallasmakerspace.thymeleaf.server.common.LogbackHighlightConverter"/>

    <appender name="NOCOLOR" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="COLOR" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%aphighlight(%d{YYYY-MM-dd HH:mm:ss.SSS} %-5level %(%replace(%logger){'radio.k2mow.','...'}){25} - %msg%n)</pattern>
        </encoder>
    </appender>
    <root level="trace">
        <appender-ref ref="COLOR"/>
    </root>
    <logger name="io.netty" level="DEBUG"/>
    <logger name="io.ktor" level="DEBUG"/>
</configuration>