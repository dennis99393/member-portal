# ============================================================================
# Member Portal Service - Environment Variables Template
# ============================================================================
#
# This file serves as a template for creating your .env file.
# Copy this file to .env and fill in the actual values.
#
# IMPORTANT: Never commit the .env file to version control!
#
# Usage:
#   cp .env.template .env
#   # Edit .env with your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------

# Enable/disable development mode (true/false)
# Development mode enables additional logging and debugging features
DEV_MODE=false

# Port the service listens on
PORT=8081

# Use mock services for external integrations (true/false)
# Set to true for local development without external dependencies
USE_MOCK_SERVICES=false

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# Primary database connection (MariaDB)
DB_URL=jdbc:mariadb://localhost:3306/member_profile
DB_USER=member_profile_user
DB_PASSWORD=your-db-password-here

# Master database connection (WHMCS/MakerManager)
DB_MASTER_URL=jdbc:mariadb://localhost:3306/master_db
DB_MASTER_USER=master_user
DB_MASTER_PASSWORD=your-master-db-password-here

# ----------------------------------------------------------------------------
# API Client Authentication & Authorization (RBAC)
# ----------------------------------------------------------------------------

# Number of API clients configured
# Update this count when adding/removing clients
API_CLIENT_COUNT=1

# Client 0: member-profile-ui
API_CLIENT_0_NAME=member-profile-ui
API_CLIENT_0_KEY=your-ui-api-key-here
API_CLIENT_0_ROLES=member:read,member:write,group:read,group:write,badge:read,dataviz:read

# Available Roles:
# - member:read     = Read member information
# - member:write    = Modify member information
# - group:read      = Read group information
# - group:write     = Manage group membership
# - badge:read      = Look up members by badge number
# - cron:execute    = Trigger administrative cron jobs
# - dataviz:read    = Access data visualization reports
# - activity:write = Log member activity (e.g., label print)

# ----------------------------------------------------------------------------
# LDAP / Active Directory Configuration
# ----------------------------------------------------------------------------

# LDAP server connection
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_USER=cn=admin,dc=example,dc=com
LDAP_PASSWORD=your-ldap-password-here

# ----------------------------------------------------------------------------
# External Integrations
# ----------------------------------------------------------------------------

# Discourse forum integration
DISCOURSE_API_KEY=your-discourse-api-key-here

# ----------------------------------------------------------------------------
# Ask DMS AI Configuration
# ----------------------------------------------------------------------------

# OpenRouter API for LLM calls (classification and answer generation)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=good-model

# Confluence wiki integration
CONFLUENCE_API_KEY=your-confluence-api-key-here
CONFLUENCE_BASE_URL=https://source.dallasmakerspace.org

# ----------------------------------------------------------------------------
# Door Controller Configuration
# ----------------------------------------------------------------------------

# HTTP socket timeout in seconds for door controller communication
# Default: 10 seconds
DOOR_CONTROLLER_TIMEOUT=10

# HTTP web interface credentials (same for all controllers)
DOOR_CONTROLLER_USERNAME=door-controller-username
DOOR_CONTROLLER_PASSWORD=your-password-here

# Door controllers are numbered sequentially (1-based indexing)
# Each controller requires: name, IP, serial, and comma-separated door list

# Controller 1: Building 102 Normal Doors
DOOR_CONTROLLER_1_IP=127.0.0.1
DOOR_CONTROLLER_1_SERIAL=1234
DOOR_CONTROLLER_1_DOORS=1,2,3,4

# Controller 2: Building 104 Normal Doors
DOOR_CONTROLLER_2_IP=127.0.0.1
DOOR_CONTROLLER_2_SERIAL=1234
DOOR_CONTROLLER_2_DOORS=1,2,3,4

# Controller 3: Building 102 Special
DOOR_CONTROLLER_3_IP=127.0.0.1
DOOR_CONTROLLER_3_SERIAL=1234
DOOR_CONTROLLER_3_DOORS=1,4

# Controller 4: Building 104 Special
DOOR_CONTROLLER_4_IP=127.0.0.1
DOOR_CONTROLLER_4_SERIAL=1234
DOOR_CONTROLLER_4_DOORS=4

# Note: Controller names are defined in application.conf and can be
# overridden with DOOR_CONTROLLER_N_NAME environment variables if needed

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------

# Log level (debug, info, warn, error)
ENV_LOG_LEVEL=info

# Elasticsearch logging (optional)
ENV_ELASTIC_HOST=localhost:9200
ENV_ELASTIC_API_KEY=your-elastic-api-key-here
